# BitLab Environment Variables
# Copy this file to .env and set your values

# BitLab data directory root (default: "data")
# This is for partial dataset downloads like fineweb-edu, falcon-refinedweb
BITLAB_DATA_DIR=data

# HuggingFace cache directories
# Base directory for all HuggingFace data (hub + datasets cache)
# Default: ~/.cache/huggingface
HF_HOME=.cache/huggingface

# HuggingFace Hub cache (models, tokenizers)
# Default: $HF_HOME/hub
HF_HUB_CACHE=.cache/huggingface

# HuggingFace datasets library cache
# Default: uses datasets library default
HF_DATASETS_CACHE=.cache/huggingface

# Optional: Add other environment variables as needed
# WANDB_API_KEY=your_key_here
# HF_TOKEN=your_token_here